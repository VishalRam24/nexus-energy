{
    "component": "EC216 Thermoelectric Generator (TEG)",
    "fidelity": "F1b",
    "description": "Temperature-dependent Bi2Te3 material properties for accurate ZT and efficiency",
    "unit": {
        "name": "Bi2Te3 TEG Module (40x40mm, 127 couples) — Temp-Dependent Properties",
        "source": "Rowe (2006) Thermoelectrics Handbook; Snyder & Toberer (2008), Nature Materials, 7, 105-114",
        "alpha0": {"value": 200e-6, "unit": "V/K", "note": "Seebeck coefficient at T0"},
        "k0": {"value": 1.5, "unit": "W/(m*K)", "note": "Thermal conductivity at T0"},
        "sigma_e0": {"value": 1e5, "unit": "S/m", "note": "Electrical conductivity at T0"},
        "T0_K": {"value": 300.0, "unit": "K", "note": "Reference temperature for property fits"},
        "a1": {"value": -2e-4, "unit": "1/K", "note": "Linear Seebeck temp coefficient"},
        "a2": {"value": 0.0, "unit": "1/K2", "note": "Quadratic Seebeck temp coefficient (set 0 for simplicity)"},
        "b1": {"value": 3e-4, "unit": "1/K", "note": "Linear thermal conductivity temp coefficient"},
        "c1": {"value": -5e-4, "unit": "1/K", "note": "Linear electrical conductivity temp coefficient"},
        "n_couples": {"value": 127, "unit": "-"},
        "A_element_m2": {"value": 1.4e-6, "unit": "m2", "note": "Cross-section area of one TE element"},
        "L_element_m": {"value": 1.6e-3, "unit": "m", "note": "Length of one TE element"},
        "module_area": {"value": 0.0016, "unit": "m2"},
        "contact_resistance_fraction": {"value": 0.05, "unit": "dimensionless", "note": "Electrical contact resistance as fraction of element resistance"}
    },
    "valid_ranges": {
        "T_hot_K": {"min": 323.0, "max": 573.0, "unit": "K"},
        "T_cold_K": {"min": 273.0, "max": 323.0, "unit": "K"}
    }
}
