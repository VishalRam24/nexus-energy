{
    "component": "EC028 Lead-Acid Battery",
    "fidelity": "F1a",
    "description": "Terminal voltage as f(SOC, I) using modified Shepherd OCV polynomial + internal resistance",
    "unit": {
        "name": "Generic 12V/100Ah flooded lead-acid battery (6 cells in series)",
        "source": "Copetti et al. (1993), J. Power Sources 47(1):109-118; Manwell & McGowan (1993), Sol. Energy 50(5):399-405",
        "n_cells": {"value": 6, "unit": "dimensionless"},
        "V_nom": {"value": 12.0, "unit": "V"},
        "C_ah": {"value": 100.0, "unit": "Ah"},
        "V_min": {"value": 10.5, "unit": "V", "note": "End-of-discharge cutoff"},
        "V_max": {"value": 14.4, "unit": "V", "note": "Maximum charge voltage"},
        "R_internal": {"value": 0.010, "unit": "Ohm", "note": "Internal resistance at 25C"},
        "ocv_coeffs": {
            "note": "OCV(SOC) = a0 + a1*SOC + a2*SOC^2 + a3*SOC^3",
            "a0": {"value": 11.5,  "unit": "V"},
            "a1": {"value": 1.5,   "unit": "V"},
            "a2": {"value": -0.5,  "unit": "V"},
            "a3": {"value": 0.3,   "unit": "V"}
        }
    },
    "valid_ranges": {
        "soc":     {"min": 0.0, "max": 1.0, "unit": "dimensionless"},
        "current": {"min": -50.0, "max": 50.0, "unit": "A", "note": "positive=discharge"}
    }
}
