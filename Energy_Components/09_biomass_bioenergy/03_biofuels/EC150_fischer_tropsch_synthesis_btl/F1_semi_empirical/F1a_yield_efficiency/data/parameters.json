        "naphtha_fraction_C5_C9": {"value": 0.15,  "unit": "dimensionless", "note": "Naphtha fraction (C5-C9)"},
        "light_gas_fraction_C1_C4":{"value": 0.20, "unit": "dimensionless", "note": "Light gas fraction (C1-C4)"}
