{
    "component": "EC192 Gas Pressure Regulator",
    "fidelity": "F1a",
    "description": "Isenthalpic throttle (Joule-Thomson) pressure regulator with Cv flow equation",
    "source": "ANSI/ISA-75.01.01 (2012) Control Valve Sizing; Burnett (1999) Joule-Thomson Coefficients for Gas Mixtures",
    "valve": {
        "name": "Typical pipeline pressure control valve",
        "Cv_default": {"value": 500.0, "unit": "gal/min/psi^0.5",
                       "note": "Flow coefficient; large pipeline regulator 100-2000"},
        "Xt_default": {"value": 0.7, "unit": "dimensionless",
                       "note": "Pressure differential ratio factor (terminal)"},
        "Fk_default": {"value": 0.972, "unit": "dimensionless",
                       "note": "Ratio of specific heats factor: Fk = gamma/1.40 for NG (1.31/1.4)"}
    },
    "gas": {
        "name": "Natural Gas (pipeline quality)",
        "molar_mass": {"value": 0.01604, "unit": "kg/mol"},
        "specific_gravity": {"value": 0.6, "unit": "dimensionless"},
        "gamma": {"value": 1.31, "unit": "dimensionless"},
        "R_specific": {"value": 518.3, "unit": "J/(kg.K)"},
        "cp": {"value": 2220.0, "unit": "J/(kg.K)", "note": "Specific heat at constant pressure"},
        "JT_coefficient": {"value": 4.5e-6, "unit": "K/Pa",
                           "note": "Joule-Thomson coefficient for NG at ~50 bar, 288 K; ~ 0.45 K/bar; positive = cooling on expansion"},
        "T_inversion": {"value": 700.0, "unit": "K",
                        "note": "JT inversion temperature for NG (above this, expansion causes warming)"}
    },
    "valid_ranges": {
        "P_up_bar": {"min": 5.0, "max": 200.0, "unit": "bar"},
        "P_down_bar": {"min": 1.0, "max": 199.0, "unit": "bar"},
        "T_up_K": {"min": 250.0, "max": 400.0, "unit": "K"},
        "Cv": {"min": 10.0, "max": 5000.0, "unit": "gal/min/psi^0.5"}
    }
}
