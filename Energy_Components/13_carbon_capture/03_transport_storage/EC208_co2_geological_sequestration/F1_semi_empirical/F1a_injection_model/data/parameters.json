{
    "component": "EC208 CO2 Geological Sequestration",
    "fidelity": "F1a",
    "description": "Injection rate vs reservoir pressure model + storage capacity from pore volume",
    "source": "van der Meer (1993); IPCC (2005) CCS Special Report Ch.5; Benson & Cole (2008) Elements",
    "reservoir": {
        "name": "Typical deep saline aquifer (1500-2500 m depth)",
