        "y_CO2_feed": {"min": 0.001, "max": 0.99, "unit": "mol_fraction"},
        "selectivity_CO2_N2": {"min": 1.0, "max": 500.0, "unit": "dimensionless"},
        "P_feed_bar": {"min": 0.5, "max": 80.0, "unit": "bar"},
        "P_perm_bar": {"min": 0.05, "max": 10.0, "unit": "bar"},
        "Q_CO2_GPU": {"min": 1.0, "max": 10000.0, "unit": "GPU"},
