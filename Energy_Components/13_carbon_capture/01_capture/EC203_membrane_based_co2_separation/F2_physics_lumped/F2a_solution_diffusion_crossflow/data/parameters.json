        "area_m2": {"value": 1000.0, "unit": "m2", "note": "Total membrane area of module"},
        "feed_flow_mol_s": {"value": 1.0, "unit": "mol/s", "note": "Total molar feed flow rate"},
        "y_CO2_feed": {"value": 0.13, "unit": "mol_fraction", "note": "CO2 mole fraction in coal flue gas feed (~13 vol%)"},
        "P_feed_bar": {"value": 1.1, "unit": "bar", "note": "Feed-side total pressure (slight compression of flue gas)"},
        "P_perm_bar": {"value": 0.2, "unit": "bar", "note": "Permeate-side total pressure (vacuum pump)"},
