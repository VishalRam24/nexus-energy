{
    "component": "EC209 Reverse Osmosis (RO)",
    "fidelity": "F1b",
    "description": "RO model with membrane fouling and temperature-dependent flux",
    "unit": {
        "name": "Generic SWRO Module with Fouling",
        "source": "Elimelech & Phillip (2011), Science, 333, 712-717; Kang & Cao (2012)",
        "A0": {"value": 4.0, "unit": "L/(m2*h*bar)", "note": "Clean membrane water permeability"},
        "membrane_area_m2": {"value": 37.0, "unit": "m2"},
        "B": {"value": 0.05, "unit": "L/(m2*h)", "note": "Salt permeability coefficient"},
        "pump_efficiency": {"value": 0.85, "unit": "dimensionless"},
        "k_foul": {"value": 0.10, "unit": "1/year", "note": "Fouling rate constant"},
        "eta_ERD": {"value": 0.95, "unit": "dimensionless"},
        "dP_membrane": {"value": 2.0, "unit": "bar"},
        "osmotic_pressure_coeff": {"value": 0.7, "unit": "bar/ppm*1000", "note": "pi = 0.7 * S/1000 bar (S in ppm)"},
