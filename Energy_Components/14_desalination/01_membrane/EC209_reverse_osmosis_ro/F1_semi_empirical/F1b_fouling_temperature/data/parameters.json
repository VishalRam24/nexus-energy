    "valid_ranges": {
        "feed_salinity_ppm": {"min": 1000.0, "max": 45000.0, "unit": "ppm"},
        "feed_pressure_bar": {"min": 20.0, "max": 80.0, "unit": "bar"},
        "feed_temperature_degC": {"min": 10.0, "max": 40.0, "unit": "degC"},
        "recovery_ratio": {"min": 0.3, "max": 0.6, "unit": "dimensionless"},
        "operating_hours": {"min": 0.0, "max": 87600.0, "unit": "hours"}
    }
