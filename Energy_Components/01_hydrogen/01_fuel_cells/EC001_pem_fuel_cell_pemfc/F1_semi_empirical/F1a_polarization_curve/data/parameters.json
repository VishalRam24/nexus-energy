{
  "component_id": "EC001",
  "component_name": "PEM Fuel Cell (PEMFC)",
  "fidelity": "F1a — Polarization Curve (Amphlett semi-empirical)",
  "source": "Amphlett et al. (1995), J. Electrochem. Soc., 142(1), 1-8",
  "default_parameters": {
    "T": 343.15,
    "N_cells": 40,
    "electrode_area": 232.0,
    "pH2": 1.0,
    "pO2": 0.21,
    "j_L": 1.5,
    "t_mem": 0.0178,
    "lambda_mem": 14.0,
    "P_rated": 5000.0
  },
  "parameter_metadata": {
    "T": {
      "description": "Operating temperature",
      "unit": "K",
      "default": 343.15,
      "notes": "70 °C typical PEMFC operating temperature"
    },
    "N_cells": {
      "description": "Number of cells in stack",
      "unit": "-",
      "default": 40
    },
    "electrode_area": {
      "description": "Active electrode area per cell",
      "unit": "cm²",
      "default": 232.0,
      "notes": "232 cm² — Ballard Mark IV reference"
    },
    "pH2": {
      "description": "Hydrogen partial pressure",
      "unit": "atm",
      "default": 1.0
    },
    "pO2": {
      "description": "Oxygen partial pressure",
      "unit": "atm",
      "default": 0.21,
      "notes": "Air-fed (21% O2); use 1.0 for pure O2"
    },
    "j_L": {
      "description": "Limiting current density",
      "unit": "A/cm²",
      "default": 1.5
    },
    "t_mem": {
      "description": "Membrane thickness",
      "unit": "cm",
      "default": 0.0178,
      "notes": "Nafion 117 (178 µm = 0.0178 cm)"
    },
    "lambda_mem": {
      "description": "Membrane water content",
      "unit": "-",
      "default": 14.0,
      "notes": "Typical fully-humidified Nafion: 14-22"
    },
    "P_rated": {
      "description": "Rated stack power",
      "unit": "W",
      "default": 5000.0
    }
  }
}
