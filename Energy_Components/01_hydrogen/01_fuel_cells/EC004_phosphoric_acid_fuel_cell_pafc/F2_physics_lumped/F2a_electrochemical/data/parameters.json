{
    "component_id": "EC004",
    "component_name": "Phosphoric Acid Fuel Cell (PAFC)",
    "fidelity": "F2a — Full Electrochemical Model with Thermal ODE",
    "source": "Razaq et al. (1989) JES 136(2) 385; Appleby & Foulkes (1989) Fuel Cell Handbook; Li et al. (2003) Chem. Mater. 15(26) 4896; Patel et al. (2012) IJHE 37(3) 2346; EG&G/DOE Fuel Cell Handbook 7th ed. (2004)",
    "unit": {
