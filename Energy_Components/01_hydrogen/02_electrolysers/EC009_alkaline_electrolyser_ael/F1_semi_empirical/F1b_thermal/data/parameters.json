{
  "component_id": "EC009",
  "component_name": "Alkaline Electrolyser (AEL)",
  "fidelity": "F1b -- Thermal (temperature-dependent KOH conductivity and kinetics)",
  "source": "Ulleberg (2003); See & White (1997); Divisek et al. (1988)",
  "default_parameters": {
    "T_ref": 343.0,
    "N_cells": 20,
    "A_cell": 0.25,
    "koh_concentration": 30.0,
    "sigma_KOH_ref": 0.5,
    "E_act_koh": 15000.0,
    "electrode_gap": 0.002,
    "i0_ref": 0.001,
    "E_act_electrode": 40000.0,
    "alpha": 0.3,
    "j_L": 5000.0,
    "bubble_coeff": 0.3,
    "faradaic_f1": 250.0,
    "faradaic_f2": 0.98
  },
  "parameter_metadata": {
    "T_ref": {"description": "Reference temperature for Arrhenius", "unit": "K", "default": 343.0},
    "N_cells": {"description": "Number of cells in stack", "unit": "-", "default": 20},
    "A_cell": {"description": "Active electrode area per cell", "unit": "m2", "default": 0.25},
    "koh_concentration": {"description": "KOH weight percent", "unit": "wt%", "default": 30.0},
    "sigma_KOH_ref": {"description": "KOH conductivity at T_ref and default concentration", "unit": "S/cm", "default": 0.5},
    "E_act_koh": {"description": "Activation energy for KOH conductivity", "unit": "J/mol", "default": 15000.0},
    "electrode_gap": {"description": "Electrode gap (distance between electrodes)", "unit": "m", "default": 0.002},
    "i0_ref": {"description": "Exchange current density at T_ref", "unit": "A/cm2", "default": 0.001},
    "E_act_electrode": {"description": "Activation energy for electrode kinetics", "unit": "J/mol", "default": 40000.0},
    "alpha": {"description": "Charge transfer coefficient", "unit": "-", "default": 0.3},
    "j_L": {"description": "Limiting current density", "unit": "A/m2", "default": 5000.0},
    "bubble_coeff": {"description": "Bubble coverage coefficient", "unit": "-", "default": 0.3},
    "faradaic_f1": {"description": "Faradaic efficiency coefficient f1", "unit": "-", "default": 250.0},
    "faradaic_f2": {"description": "Faradaic efficiency coefficient f2", "unit": "-", "default": 0.98}
  },
  "valid_ranges": {
    "current_density": {"min": 0.0, "max": 5000.0, "unit": "A/m2"},
    "temperature": {"min": 333.0, "max": 373.0, "unit": "K"}
  }
}
